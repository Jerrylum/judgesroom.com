/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "judgesroom-com",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-29",
	"compatibility_flags": ["nodejs_compat"],
	// Workers Cache: only CachedMedia is cached. Default gateway stays uncached
	// so /ws, /join, uploads, and static assets are not served from cache / billed
	// as if the whole Worker were cache-enabled for assets.
	"cache": {
		"enabled": true
	},
	"exports": {
		"default": { "type": "worker", "cache": { "enabled": false } },
		"CachedMedia": { "type": "worker", "cache": { "enabled": true } }
	},
	"env": {
		"development": {
			"durable_objects": {
				"bindings": [
					{
						"class_name": "WebSocketHibernationServer",
						"name": "WEBSOCKET_HIBERNATION_SERVER"
					}
				]
			},
			"r2_buckets": [
				{
					"binding": "TEAM_PHOTOS",
					"bucket_name": "judgesroom-team-photos",
					"preview_bucket_name": "judgesroom-team-photos-preview"
				}
			],
			"services": [
				{
					"binding": "CACHED_MEDIA",
					"service": "judgesroom-com-development",
					"entrypoint": "CachedMedia"
				}
			]
		},
		"beta": {
			"assets": {
				"directory": "../web/build",
				"not_found_handling": "404-page",
				"html_handling": "auto-trailing-slash",
				"run_worker_first": ["/ws", "/join", "/media/*"],
				"binding": "ASSETS"
			},
			"durable_objects": {
				"bindings": [
					{
						"class_name": "WebSocketHibernationServer",
						"name": "WEBSOCKET_HIBERNATION_SERVER"
					}
				]
			},
			"r2_buckets": [
				{
					"binding": "TEAM_PHOTOS",
					"bucket_name": "judgesroom-team-photos",
					"preview_bucket_name": "judgesroom-team-photos-preview"
				}
			],
			"services": [
				{
					"binding": "CACHED_MEDIA",
					"service": "judgesroom-com-beta",
					"entrypoint": "CachedMedia"
				}
			]
		},
		"production": {
			"assets": {
				"directory": "../web/build",
				"not_found_handling": "404-page",
				"html_handling": "auto-trailing-slash",
				"run_worker_first": ["/ws", "/join", "/media/*"],
				"binding": "ASSETS"
			},
			"durable_objects": {
				"bindings": [
					{
						"class_name": "WebSocketHibernationServer",
						"name": "WEBSOCKET_HIBERNATION_SERVER"
					}
				]
			},
			"r2_buckets": [
				{
					"binding": "TEAM_PHOTOS",
					"bucket_name": "judgesroom-team-photos"
				}
			],
			"services": [
				{
					"binding": "CACHED_MEDIA",
					"service": "judgesroom-com-production",
					"entrypoint": "CachedMedia"
				}
			]
		}
	},
	"migrations": [
		{
			"new_sqlite_classes": ["WebSocketHibernationServer"],
			"tag": "v1"
		}
	],
	"rules": [
		{
			"type": "Text",
			"globs": ["**/*.sql"],
			"fallthrough": true
		}
	],
	"observability": {
		"enabled": true
	}
}
